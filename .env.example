OXIDERELAY_IMAGE=kpakozz96pyc/oxiderelay:latest
OXIDERELAY_HOST=0.0.0.0
OXIDERELAY_PORT=8080
OXIDERELAY_PUBLISHED_PORT=8080
OXIDERELAY_DATABASE_PATH=/data/oxiderelay.sqlite
OXIDERELAY_FRONTEND_DIST_PATH=/app/frontend-dist
OXIDERELAY_SESSION_COOKIE_NAME=oxiderelay_session
OXIDERELAY_SESSION_TTL_HOURS=168
OXIDERELAY_SESSION_COOKIE_SECURE=false
OXIDERELAY_PUBLIC_DELIVERY_ENABLED=true
OXIDERELAY_DELIVERY_TOKEN=
# These vars are required only for first startup with an empty DB
OXIDERELAY_ADMIN_EMAIL=
OXIDERELAY_ADMIN_PASSWORD=
