[server]
host = "127.0.0.1"
port = "8080"

[database]
path = "./data/oxiderelay.sqlite"

[session]
cookie_name = "oxiderelay_session"
ttl_hours = "168"
cookie_secure = "false"

[delivery]
public_enabled = "true"
# token = "replace-with-a-long-random-secret"

[bootstrap_admin]
email = "admin@example.com"
password = "change-me"

[frontend]
dist_path = "./frontend/dist"
